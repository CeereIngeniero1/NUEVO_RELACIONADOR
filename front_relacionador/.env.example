# =============================================================================
# Front Relacionador — copiar a ".env" y ajustar (NO subir .env con secretos)
# Carga: front_relacionador/app.js al iniciar; expone GET /config.js al navegador
# Tras cambiar valores: reiniciar "node app.js" y recargar Asignar RIPS (Ctrl+F5)
# =============================================================================

# Puerto del servidor Express del front (compat: PORT si FRONT_PORT no está definido)
FRONT_PORT=3100

# Puerto del backend API (si no defines API_BASE_URL: mismo host del navegador + BACK_PORT)
BACK_PORT=3000

# Opcional: URL completa del backend (sin barra final). Útil detrás de proxy o otro host.
# API_BASE_URL=http://localhost:3000

# Opcional: sesión / JWT del propio front (rutas de ejemplo en app.js)
# SESSION_SECRET=
# JWT_SECRET=

# -----------------------------------------------------------------------------
# IHCE — UI en Asignar RIPS (SweetAlert: sandbox / producción)
# Se inyectan en window.__APP_CONFIG__ vía /config.js
# -----------------------------------------------------------------------------
# Mostrar opción Sandbox en el selector de envío (si IHCE_FORCE_PROD_ONLY no bloquea)
IHCE_ENABLE_SANDBOX=true
# Mostrar opción Producción (si IHCE_FORCE_SANDBOX_ONLY no bloquea)
IHCE_ENABLE_PROD=true

# Forzar un solo ambiente (misma semántica que backend / visor)
IHCE_FORCE_SANDBOX_ONLY=false
IHCE_FORCE_PROD_ONLY=false

# -----------------------------------------------------------------------------
# RDA — envío IHCE desde "Guardar RDA Consulta Externa"
# -----------------------------------------------------------------------------
# true  = unificado: al confirmar envío IHCE se guarda y envía RDA Paciente + RDACE;
#         en pantalla solo se muestra el tipo "RDA Consulta Externa".
# false = separado: aparecen "RDA Paciente" y "RDA Consulta Externa"; al enviar desde CE
#         solo va RDACE a IHCE (el paciente se guarda/envía con su propio botón).
RDA_IHCE_UNIFIED_SEND=true

# Nota: la versión de API RDA (legacy vs v2) suele fijarse con localStorage RDA_API_VERSION
# o extendiendo /config.js; no es obligatorio en este .env.
