# Puerto del servidor Express del front (compat: PORT si FRONT_PORT no está definido)
FRONT_PORT=3100

# Puerto del backend API (usado si API_BASE_URL no está definido: mismo host que el navegador + BACK_PORT)
BACK_PORT=3000

# Opcional: URL completa del backend (evita inferencia por host/puerto). Sin barra final.
# API_BASE_URL=http://localhost:3000
