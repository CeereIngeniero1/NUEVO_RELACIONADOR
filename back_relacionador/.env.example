# Puerto del API (Express). Compat: PORT si BACK_PORT no está definido.
BACK_PORT=3000

# Raíz de carpetas RIPS (ARCHIVOS_RIPS, ARCHIVOS_RIPS_JSON, XMLS, ARCHIVOS_DE_ENVIO).
# Por defecto: C:\CeereSio\RIPS_2275. Alias: RIPS_2275_ROOT
# CEERE_RIPS_DATA_ROOT=C:\CeereSio\RIPS_2275

# SQL Server — obligatorio en producción (o se completará desde CRINFO.ini la primera vez).
DB_SERVER=localhost\\INSTANCIA
DB_DATABASE=NombreBaseDatos
DB_USER=CeereRIPS
DB_PASSWORD=crsoft
DB_PORT=1433

# Opcionales (coinciden con el comportamiento anterior: sin cifrar, cert confiable)
# DB_ENCRYPT=false
# DB_TRUST_CERT=true

# Ruta opcional al INI si no usas la ubicación por defecto
# CRINFO_INI_PATH=C:/ceeresio/crinfo.ini
