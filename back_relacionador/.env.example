# Copiar a .env en esta misma carpeta (back_relacionador). No commitear .env.
# Integración IHCE / consulta externa RDA (ajustar según ambiente).

IHCE_API_BASE_URL=https://sandbox.ihcecol.gov.co/ihce
IHCE_TENANT_ID=
IHCE_CLIENT_ID=
IHCE_CLIENT_SECRET=
IHCE_SCOPE=
IHCE_APIM_SUBSCRIPTION_KEY=

# RDACE: NIT y nombre IPS (custodian / cabecera prestador).
IHCE_RDACE_DEFAULT_NIT_IPS=
IHCE_RDACE_DEFAULT_NOMBRE_IPS=

# Opcional: omitir alergias en envío RDACE si el validador sandbox falla.
# IHCE_RDACE_OMIT_ALLERGY_INTOLERANCE=true
