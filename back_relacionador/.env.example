# =============================================================================
# Backend Relacionador — copiar a ".env" y ajustar (NO subir .env con secretos)
# =============================================================================

# Puerto del API (Express). Compat: PORT si BACK_PORT no está definido.
BACK_PORT=3000

# -----------------------------------------------------------------------------
# SQL Server — obligatorio (o se completa desde CRINFO.ini la primera vez)
# -----------------------------------------------------------------------------
DB_SERVER=localhost\\INSTANCIA
DB_DATABASE=CeereSio
DB_USER=CeereRIPS
DB_PASSWORD=crsoft
DB_PORT=1433

# Opcionales (por defecto: sin cifrar, cert confiable)
# DB_ENCRYPT=false
# DB_TRUST_CERT=true

# Ruta opcional al INI si no usas la ubicación por defecto
# CRINFO_INI_PATH=C:/ceeresio/crinfo.ini

# -----------------------------------------------------------------------------
# Producto — mostrar u ocultar módulos RIPS / RDA (menú, páginas, paneles)
# -----------------------------------------------------------------------------
# El front combina (AND) estos valores con front_relacionador/.env:
# si ENABLE_RDA=false aquí O en el front → se ocultan Visor, Envío RDA, card RDA, etc.
# Tras cambiar: reiniciar BACK y FRONT, y Ctrl+F5.
#   Solo RIPS: ENABLE_RIPS=true  / ENABLE_RDA=false
#   Solo RDA:  ENABLE_RIPS=false / ENABLE_RDA=true
#   Ambos:     ENABLE_RIPS=true  / ENABLE_RDA=true
ENABLE_RIPS=true
ENABLE_RDA=false

# -----------------------------------------------------------------------------
# RIPS
# -----------------------------------------------------------------------------
# Obligatorio: raíz donde están ARCHIVOS_RIPS, ARCHIVOS_RIPS_JSON, XMLS, ARCHIVOS_DE_ENVIO.
# Alias: RIPS_2275_ROOT
CEERE_RIPS_DATA_ROOT=C:\CeereSio\RIPS_2275

# Facturación nueva: quita ceros a la izquierda del folio en numFactura del JSON RIPS
# (MR0009219 → MR9219). Al empaquetar, el numFactura igual se alinea con el XML.
# RIPS_NUM_FACTURA_SIN_CEROS=true

# -----------------------------------------------------------------------------
# Historias Clínicas
# -----------------------------------------------------------------------------
# Formatos de historia clínica (HTML/HTM)
CEERE_FORMATOS_HC_PATH=C:\CeereSio\Formatos HC
# Terminal y Rips al guardar HC (Evaluación Entidad). Rips: 1 como Ceere desktop; 0 para no enviar columna Rips.
CEERE_ID_TERMINAL=1392
CEERE_HC_INSERT_RIPS=1

# -----------------------------------------------------------------------------
# IHCE / RDA (Ministerio)
# Las credenciales OAuth (tenant, client, secret, scope, subscription key) y el
# custodian se configuran por empresa y ambiente en la tabla dbo.CredencialesIhce
# (pantalla "Credenciales IHCE"), no en este archivo.
# -----------------------------------------------------------------------------

# Ambiente IHCE por defecto (visor / consultas): sandbox | prod
IHCE_DEFAULT_AMBIENTE=sandbox
# Forzar un solo ambiente IHCE (envíos / visor / tokens). Si ambas en true, prevalece PROD.
IHCE_FORCE_SANDBOX_ONLY=false
IHCE_FORCE_PROD_ONLY=false

# Timeout ms llamadas salientes a IHCE (OAuth / FHIR). Por defecto 45000.
# IHCE_OUTBOUND_TIMEOUT_MS=45000

# Validación estricta de obligatorios antes de enviar a IHCE:
# true  -> bloquea envío si faltan obligatorios (recomendado prod)
# false -> no bloquea (útil para pruebas internas)
RDA_STRICT_REQUIRED_FIELDS=true

# Versión de rutas de envío masivo RDA: legacy (defecto) | v2
# RDA_ENVIO_MASIVO_VERSION=legacy

# RDACE: valores por defecto del prestador si CredencialesIhce no trae custodian
# IHCE_RDACE_DEFAULT_NIT_IPS=
# IHCE_RDACE_DEFAULT_NOMBRE_IPS=
# IHCE_RDACE_DEFAULT_CODIGO_PRESTADOR=
# IHCE_RDACE_DEFAULT_REPS_PERIOD_START=2011-11-30
# IHCE_RDACE_DEFAULT_DIVIPOLA_MUNICIPIO=05001
# IHCE_RDACE_DEFAULT_DIVIPOLA_DEPTO=05
# CUPS de Encounter.serviceType si no hay CUPS en la prescripción RDACE ni en el RIPS
# (prioridad: procedimiento RDACE → RIPS → estas variables → 890201).
# IHCE_RDACE_DEFAULT_ENCOUNTER_CUPS_CODE=890201
# IHCE_RDACE_DEFAULT_ENCOUNTER_CUPS_DISPLAY=CONSULTA DE PRIMERA VEZ POR MEDICINA GENERAL
# true = no enviar recurso AllergyIntolerance en RDACE (pruebas)
# IHCE_RDACE_OMIT_ALLERGY_INTOLERANCE=false

# -----------------------------------------------------------------------------
# Variables solo en FRONT (front_relacionador/.env — GET /config.js)
#   IHCE_DEFAULT_AMBIENTE, IHCE_FORCE_* (selector de ambiente en visor / envío RDA),
#   IHCE_ENABLE_SANDBOX, IHCE_ENABLE_PROD, RDA_IHCE_UNIFIED_SEND, ENABLE_RIPS, ENABLE_RDA
# -----------------------------------------------------------------------------
