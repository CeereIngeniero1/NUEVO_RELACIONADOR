# =============================================================================
# Backend Relacionador — copiar a ".env" y ajustar (NO subir .env con secretos)
# =============================================================================

# Puerto del API (Express). Compat: PORT si BACK_PORT no está definido.
BACK_PORT=3000

# Obligatorio: raíz donde están ARCHIVOS_RIPS, ARCHIVOS_RIPS_JSON, XMLS, ARCHIVOS_DE_ENVIO.
# Ajusta a la ruta real del servidor (no hay valor por defecto en el código).
# Alias: RIPS_2275_ROOT
CEERE_RIPS_DATA_ROOT=C:\CeereSio\RIPS_2275

# Formatos de historia clínica (HTML/HTM) para el módulo Historias Clínicas
CEERE_FORMATOS_HC_PATH=C:\CeereSio\Formatos HC
# Terminal y Rips al guardar HC (Evaluación Entidad). Rips: 1 como Ceere desktop; poner 0 para no enviar columna Rips.
CEERE_ID_TERMINAL=1392
CEERE_HC_INSERT_RIPS=1

# -----------------------------------------------------------------------------
# Producto — mostrar u ocultar módulos RIPS / RDA (menú, páginas, paneles)
# -----------------------------------------------------------------------------
# IMPORTANTE: la UI lee estos flags desde front_relacionador/.env (GET /config.js).
# Colócalos también allí con los mismos nombres. Por defecto ambos son true.
#
# true  = mostrar todo lo del módulo
# false = no mostrar absolutamente nada de ese módulo
#
# Ejemplos:
#   Solo RDA:  ENABLE_RIPS=false  +  ENABLE_RDA=true
#   Solo RIPS: ENABLE_RIPS=true   +  ENABLE_RDA=false
#   Ambos:     ENABLE_RIPS=true   +  ENABLE_RDA=true
ENABLE_RIPS=true
ENABLE_RDA=true

# Depuración HC (GET /apiV3/debug/ConsultarFacturas|Presupuestos|DatosdeUsuarioHC — sin token)
# Usar solo en desarrollo; no exponer en producción sin firewall.

# SQL Server — obligatorio en producción (o se completará desde CRINFO.ini la primera vez).
DB_SERVER=localhost\\INSTANCIA
DB_DATABASE=CeereSio
DB_USER=CeereRIPS
DB_PASSWORD=crsoft
DB_PORT=1433

# Opcionales (coinciden con el comportamiento anterior: sin cifrar, cert confiable)
# DB_ENCRYPT=false
# DB_TRUST_CERT=true

# Ruta opcional al INI si no usas la ubicación por defecto
# CRINFO_INI_PATH=C:/ceeresio/crinfo.ini

# -----------------------------------------------------------------------------
# IHCE (Ministerio) — necesario para enviar RDA al ministerio (sandbox y/o prod)
# Copiar valores desde SISPRO: AdminTokens / consultar token (preproducción o producción)
# Documentación en repo: docs/Envio/consulta_token_sispro.md
# Importante: no anteponer # a las líneas IHCE_SANDBOX_* ni IHCE_PROD_*; si quedan
# comentadas, el envío en sandbox/prod fallará con "Faltan variables de entorno IHCE".
# -----------------------------------------------------------------------------
IHCE_SANDBOX_BASE_URL=https://sandbox.ihcecol.gov.co/ihce
IHCE_SANDBOX_TENANT_ID=
IHCE_SANDBOX_CLIENT_ID=
IHCE_SANDBOX_CLIENT_SECRET=
IHCE_SANDBOX_SCOPE=
IHCE_SANDBOX_SUBSCRIPTION_KEY=

# Producción (mismos nombres que lee RdaPaciente/RdaConsultaExterna EnviarIHCE con ambiente prod)
IHCE_PROD_BASE_URL=https://www.ihcecol.gov.co/ihce
IHCE_PROD_TENANT_ID=
IHCE_PROD_CLIENT_ID=
IHCE_PROD_CLIENT_SECRET=
IHCE_PROD_SCOPE=
IHCE_PROD_SUBSCRIPTION_KEY=

# Ambiente IHCE por defecto (visor / consultas): sandbox | prod
IHCE_DEFAULT_AMBIENTE=sandbox
# Forzar un solo ambiente IHCE en servidor (envíos / visor / tokens)
IHCE_FORCE_SANDBOX_ONLY=false
IHCE_FORCE_PROD_ONLY=false

# Timeout ms llamadas salientes a IHCE (OAuth / FHIR). Por defecto ~45000 en código.
# IHCE_OUTBOUND_TIMEOUT_MS=45000

# Validación estricta de obligatorios antes de enviar a IHCE:
# true  -> bloquea envío si faltan obligatorios (recomendado prod)
# false -> no bloquea (útil para pruebas internas)
RDA_STRICT_REQUIRED_FIELDS=true
# RDACE (temporal QA): completa cardinalidades mínimas de estructura en CE
# cuando faltan datos clínicos reales (diagnóstico principal / entorno / modalidad).
RDACE_STRUCTURAL_FALLBACK=false

IHCE_SANDBOX_CUSTODIAN_REPS=0500112124
IHCE_SANDBOX_CUSTODIAN_NIT=900479959-9
IHCE_SANDBOX_CUSTODIAN_NAME=Grupo Médico Especializado Medellín S.A.S

# Opcional: custodian solo para consulta Organization en prod (POST .../IhceConsultarOrganizacion/produccion).
# Si se omiten, por campo se usan IHCE_SANDBOX_CUSTODIAN_* y/o IHCE_RDACE_DEFAULT_*.
# IHCE_PROD_CUSTODIAN_NIT=
# IHCE_PROD_CUSTODIAN_REPS=
# IHCE_PROD_CUSTODIAN_NAME=

IHCE_RDACE_DEFAULT_NIT_IPS=900479959-9
IHCE_RDACE_DEFAULT_NOMBRE_IPS=Grupo Médico Especializado Medellín S.A.S
# Opcionales (RDACE / bundle FHIR)
# IHCE_RDACE_DEFAULT_CODIGO_PRESTADOR=
# IHCE_RDACE_DEFAULT_REPS_PERIOD_START=2011-11-30
# IHCE_RDACE_DEFAULT_DIVIPOLA_MUNICIPIO=05001
# IHCE_RDACE_DEFAULT_DIVIPOLA_DEPTO=05
# CUPS del servicio prestado en Encounter.serviceType (1..1), distinto de ServiceRequest 0..*
# (órdenes de procedimiento en la sección 61146-1). Solo se usa si no hay CUPS en prescripción
# RDACE ni en el RIPS del paciente ([Evaluación Entidad Rips].[Codigo Rips]).
# Prioridad: procedimiento RDACE (CUPS+finalidad) → RIPS → estas variables → 890201 en código.
# IHCE_RDACE_DEFAULT_ENCOUNTER_CUPS_CODE=890201
# IHCE_RDACE_DEFAULT_ENCOUNTER_CUPS_DISPLAY=CONSULTA DE PRIMERA VEZ POR MEDICINA GENERAL
# true = no enviar recurso AllergyIntolerance en RDACE (pruebas)
# IHCE_RDACE_OMIT_ALLERGY_INTOLERANCE=false

# Versión de rutas masivas RDA (legacy por defecto)
# RDA_ENVIO_MASIVO_VERSION=legacy

# -----------------------------------------------------------------------------
# Variables solo en FRONT (Asignar RIPS — GET /config.js)
# Archivo: front_relacionador/.env.example
#   RDA_IHCE_UNIFIED_SEND, IHCE_ENABLE_SANDBOX, IHCE_ENABLE_PROD, IHCE_FORCE_* (UI)
# El backend no lee RDA_IHCE_UNIFIED_SEND; debe configurarse en el .env del front.
# -----------------------------------------------------------------------------